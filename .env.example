# Copy this file to .env.local and fill in your Supabase project values.
# These are required only for the Cloud Web Workspace deployment (npm run build:web).
# The desktop app / local build does NOT require these.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API URL for the FastAPI backend (when running as a hosted web service)
VITE_API_URL=https://your-api-server.com/api/v1
